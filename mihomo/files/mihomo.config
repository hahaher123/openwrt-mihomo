# Mihomo service configuration.
# Shared by /etc/init.d/mihomo and luci-app-mihomo.
# Note: "enabled" gates service start; use LuCI to toggle and control the service.
# "dashboard" (optional) is the LuCI-embedded admin UI URL, e.g.
#   option dashboard 'http://192.168.1.1:9090/ui'

config mihomo 'main'
        option enabled '0'
        option user 'root'
        option conffile '/etc/mihomo/config.yaml'
        option workdir '/usr/share/mihomo'
        list ifaces 'wan'
        list ifaces 'wan_6'
        option log_stderr '1'
        option log_stdout '1'
        # 1 = apply tproxy policy route + nft rules on start, remove on stop
        option transparent '0'
