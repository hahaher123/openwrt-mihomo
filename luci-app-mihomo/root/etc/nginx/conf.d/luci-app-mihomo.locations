# luci-app-mihomo: 面板同源反代（http/https 自适应）
#
# LuCI「后台管理」页的仪表盘 iframe 读 uci 的 mihomo.main.dashboard；
# 默认值是 http://<路由器>:9090/ui —— 页面一旦走 https，嵌 http iframe 会被
# 浏览器混合内容策略直接拦截（自签证书下 iframe 里也无法点「继续访问」）。
#
# 解法是同源反代：iframe 与面板 API 都走 nginx 的相对路径，自动继承页面协议。
# 本文件被 uci.conf 生成的 server 块经 include conf.d/*.locations 引入，
# 80 / 443 同份生效。uci-defaults/luci-app-mihomo-dashboard 已把面板地址
# 默认设为 /mihomo-ui/，装上即用；用户仍可在「运行参数」页改回直连地址。
#
# metacubexd 面板的 defaultBackendURL 为空时回落 window.location.origin，
# API 请求会直接打 nginx 根路径，所以根端点也要转发到 9090。
# 刷新日志 / 连接页是 WebSocket，需要 Upgrade 头。

# 面板静态文件（源站路径 /ui/，对外收在 /mihomo-ui/ 前缀下）
location /mihomo-ui/ {
	proxy_pass http://127.0.0.1:9090/ui/;
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_set_header Host $host;
	proxy_read_timeout 3600s;
}

# mihomo REST/WS API 根端点（面板回落 origin 时使用）
location ~ ^/(version|configs|proxies|group|rules|providers|connections|logs|traffic|memory|dns|cache|upgrade|restart)(/|$) {
	proxy_pass http://127.0.0.1:9090;
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_set_header Host $host;
	proxy_read_timeout 3600s;
}
